#reading in data
my.data <- read.csv("Acclimation_qPCR_forR.csv")
str(my.data)
colnames(my.data)[1] <- "Tissue" #fix column heading
my.data$AcclimationTime <- as.factor (my.data$AcclimationTime) #convert accl time to factors

#plotting relative catalase mRNA abundance (relative to week 0)
ggplot(my.data, aes(x = Tissue, y = RelativeCatalase_mRNA, fill = AcclimationTime)) + 
  geom_boxplot() + scale_fill_manual(values = c("#FFFFFF", "#56B4E9", "#0072b2")) + 
  labs(x="Tissue", y="Relative Catalase mRNA abundance") +
  scale_y_continuous(limits=c(0,7.5), expand=c(0,0)) + 
  MyTheme
#export as "AcclimationCatalaseRNA_Relative.pdf" 3" high x 3.5" wide

#subsetting data for stats
FB <- my.data[which(my.data$Tissue=="FB"),]
MG <- my.data[which(my.data$Tissue=="MG"),]
MT <- my.data[which(my.data$Tissue=="MT"),]

#ANOVA for fat body: mRNA increases mid-acclimation (3 vs. 0 and 6 week)
