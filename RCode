#reading in data
counts <- read.csv("SurvivalTemperature_forR.csv", stringsAsFactors = FALSE)
str(counts)
counts #temperature treatments in rows, live-dead data in columns

#reordering factor levels for plotting
counts$Temp <- factor(counts$Temp, 
                      levels = c("Low", "Mod", "High"),
                      labels = c(4, 15, 22))

ggplot(counts, aes(x = Temp, y = PAlive)) + 
  geom_col(fill="#0072b2", colour="black", width=0.75) +  
  geom_errorbar(aes(ymin=PAlive-SEP, ymax=PAlive+SEP), width=.2,
                position=position_dodge(.9)) +
  labs(x="Post-Acclimation Temperature (°C)", 
       y="Proportion Alive Post-Freeze") +
  scale_y_continuous(limits=c(0,1), expand=c(0,0)) + 
  MyTheme
#export as SurvivalTemperature.pdf" 3" high x 3.5" wide


#formatting data for Chi-square test
#keep only Alive and Dead columns and replace first column with row names
counts <- counts[,2:3]
rownames(counts) <- c("Low", "Mod", "High")

chisq.test(counts) #output pasted below
#Pearson's Chi-squared test
#
#data:  counts
#X-squared = 8.5546, df = 2, p-value = 0.01388

